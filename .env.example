# Server Configuration
PORT=999

# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/urlshortener?retryWrites=true&w=majority

# Note: Replace the following in MONGO_URI:
# - username: Your MongoDB username
# - password: Your MongoDB password
# - cluster: Your MongoDB cluster name
# - urlshortener: Your database name (you can change this)
